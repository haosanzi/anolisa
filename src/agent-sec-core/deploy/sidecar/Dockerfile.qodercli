# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=alibaba-cloud-linux-4-registry.cn-hangzhou.cr.aliyuncs.com/alinux4/alinux4:4.0.4

FROM ${BASE_IMAGE}

ARG AGENT_SEC_GID=10001
ARG AGENT_SEC_UID=10001
ARG IMAGE_VERSION=0.8.0
ARG QODERCLI_VERSION=latest

ENV AGENT_SEC_DAEMON_SOCKET=/run/agent-sec/runtime/daemon.sock \
    AGENT_SEC_DATA_DIR=/var/lib/agent-sec/persistent/events \
    HOME=/home/agent-sec \
    QODER_CONFIG_DIR=/home/agent-sec/.qoder \
    QODER_WORKING_DIR=/home/agent-sec/workspace \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install the repository definition first so that agent-sec-core can be
# installed directly as an RPM in the following dnf transaction.
RUN sed -i -e "s/cloud.aliyuncs/aliyun/g" /etc/yum.repos.d/*.repo \
    && dnf install --assumeyes alinux-agentic-os-repos \
    && sed -i -e "s/cloud.aliyuncs/aliyun/g" /etc/yum.repos.d/*.repo \
    && dnf install --assumeyes \
        agent-sec-core \
        bash \
        bubblewrap \
        ca-certificates \
        curl \
        git \
        gnupg2 \
        jq \
        npm \
        procps-ng \
        python3 \
        shadow-utils \
        tar \
        unzip \
        which \
    && npm install --global "@qoder-ai/qodercli@${QODERCLI_VERSION}" \
    && node -e 'const major = Number(process.versions.node.split(".")[0]); process.exit(major >= 20 ? 0 : 1)' \
    && python3 -c 'import sys; raise SystemExit(0 if (3, 11) <= sys.version_info < (3, 12) else 1)' \
    && QODER_WORKING_DIR=/ qodercli --version \
    && agent-sec-cli --help >/dev/null \
    && test -x /opt/agent-sec/qoder-plugin/install.sh \
    && dnf clean all \
    && rm -rf /var/cache/dnf/* /root/.npm

RUN groupadd --gid "${AGENT_SEC_GID}" agent-sec \
    && useradd \
        --uid "${AGENT_SEC_UID}" \
        --gid "${AGENT_SEC_GID}" \
        --no-create-home \
        --home-dir /home/agent-sec \
        --shell /bin/bash \
        agent-sec \
    && install -d -o "${AGENT_SEC_UID}" -g "${AGENT_SEC_GID}" -m 0700 \
        /home/agent-sec \
        /home/agent-sec/.qoder \
        /home/agent-sec/workspace \
        /run/agent-sec/runtime \
        /var/lib/agent-sec/persistent/events

COPY --chmod=0755 entrypoint-qodercli.sh /usr/local/bin/entrypoint-qodercli.sh

LABEL org.opencontainers.image.description="Qoder CLI caller image with agent-sec-core plugin" \
      org.opencontainers.image.source="https://github.com/alibaba/anolisa" \
      org.opencontainers.image.title="agent-sec-qodercli" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

USER ${AGENT_SEC_UID}:${AGENT_SEC_GID}
WORKDIR /home/agent-sec/workspace

ENTRYPOINT ["/usr/local/bin/entrypoint-qodercli.sh"]
