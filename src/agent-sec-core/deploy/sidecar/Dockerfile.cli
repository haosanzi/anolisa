# ---------------------------------------------------------------------
# Dockerfile.sec-core
# 用途：构建 agent-sec-core CLI / OpenClaw 镜像（对应文档 2.1 节 OpenClaw/CLI 镜像）
# 约束：
#   - agent-sec-cli、openclaw 位于 PATH
#   - 包含 bash、jq 以及 /usr/local/share/anolisa/adapters/sec-core/openclaw 下插件文件
#   - OpenClaw 版本 >= 2026.4.14
#   - 以 UID/GID 10001:10001 运行
#   - 不启动 agent-sec-daemon
#   - 通过 entrypoint-openclaw.sh 提供前台主进程，并在运行时完成插件注册
# ---------------------------------------------------------------------
FROM ubuntu:24.04

# install base packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bubblewrap \
        gnupg \
        ca-certificates \
        wget \
        curl \
        git \
        tar \
        unzip \
        openssh-server \
        zip \
        xz-utils \
        python3 \
        python3-pip \
        man-db \
        procps \
        iproute2 \
        net-tools \
        iputils-ping \
        dnsutils \
        iotop \
        iftop \
        sysstat \
        psmisc \
        lsof \
        strace \
        make \
        jq \
        bash \
        tree && \
    rm -rf /var/lib/apt/lists/*

# install Node.js for OpenClaw's current engine requirement
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# install fixed OpenClaw version (document requires >= 2026.4.14)
RUN npm install -g openclaw@^2026.4.14

# install sec-core through the anolisa CLI raw backend
RUN apt-get update && \
    curl -fsSL https://get.agentic-os.sh | bash && \
    install -m 0755 /root/.local/bin/anolisa /usr/local/bin/anolisa && \
    anolisa --install-mode system install sec-core --backend raw && \
    rm -rf /var/lib/apt/lists/*

# create non-root user/group 10001:10001 as required by the sidecar contract
RUN groupadd -g 10001 agent-sec && \
    useradd -u 10001 -g agent-sec -m -d /home/agent-sec -s /bin/bash agent-sec

# ensure the runtime user can read the raw-installed plugin files
RUN chown -R 10001:10001 /usr/local/share/anolisa/adapters/sec-core/openclaw && \
    chmod -R u+rX /usr/local/share/anolisa/adapters/sec-core/openclaw

# default environment matching the documented recommendations
ENV HOME=/var/lib/agent-sec/persistent \
    OPENCLAW_STATE_DIR=/var/lib/agent-sec/persistent/openclaw-state \
    OPENCLAW_WORKSPACE_DIR=/var/lib/agent-sec/persistent/openclaw-workspace \
    AGENT_SEC_DAEMON_SOCKET=/run/agent-sec/runtime/daemon.sock \
    AGENT_SEC_DATA_DIR=/var/lib/agent-sec/persistent/events

COPY entrypoint-openclaw.sh /usr/local/bin/entrypoint-openclaw.sh
RUN chmod +x /usr/local/bin/entrypoint-openclaw.sh

# the CLI image must not start agent-sec-daemon; entrypoint runs a foreground process
ENTRYPOINT ["/usr/local/bin/entrypoint-openclaw.sh"]
