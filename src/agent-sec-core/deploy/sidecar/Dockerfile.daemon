# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=alibaba-cloud-linux-4-registry.cn-hangzhou.cr.aliyuncs.com/alinux4/alinux4:latest

FROM ${BASE_IMAGE}

ARG AGENT_SEC_GID=10001
ARG AGENT_SEC_UID=10001
ARG IMAGE_VERSION=0.10.1

ENV ANOLISA_BIN=/root/.local/bin/anolisa \
    RAW_REPO_DIR=/opt/anolisa-raw-repo

ENV AGENT_SEC_DAEMON_SOCKET=/run/agent-sec/runtime/daemon.sock \
    AGENT_SEC_DATA_DIR=/var/lib/agent-sec/events \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    XDG_CONFIG_HOME=/var/lib/agent-sec/config \
    XDG_DATA_HOME=/var/lib/agent-sec/data

# prepare-local-raw-repo.sh builds sec-core from the current checkout and
# publishes it under the Anolisa raw repository layout expected by --repo.
COPY deploy/sidecar/raw-repo/ ${RAW_REPO_DIR}/

# The raw backend currently does not install RPM system dependencies on
# Alinux. Install the dependencies declared by sec-core before installing the
# current checkout from the image-local Anolisa repository.
RUN sed -i -e "s/cloud.aliyuncs/aliyun/g" /etc/yum.repos.d/*.repo \
    && dnf install --assumeyes \
        bubblewrap \
        ca-certificates \
        curl \
        gnupg2 \
        jq \
        nodejs \
        shadow-utils \
        systemd \
        tar \
    && curl -fsSL https://get.agentic-os.sh | bash \
    && "${ANOLISA_BIN}" --install-mode system \
        install sec-core --backend raw --repo "file://${RAW_REPO_DIR}/v1" \
    && agent-sec-cli --help >/dev/null \
    && agent-sec-daemon --help >/dev/null \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

ENV HOME=/home/agent-sec

RUN groupadd --gid "${AGENT_SEC_GID}" agent-sec \
    && useradd \
        --uid "${AGENT_SEC_UID}" \
        --gid "${AGENT_SEC_GID}" \
        --create-home \
        --home-dir /home/agent-sec \
        --shell /sbin/nologin \
        agent-sec \
    && install -d -o "${AGENT_SEC_UID}" -g "${AGENT_SEC_GID}" -m 0700 \
        /run/agent-sec \
        /var/lib/agent-sec/config \
        /var/lib/agent-sec/data \
        /var/lib/agent-sec/events

COPY --chmod=0755 deploy/sidecar/healthcheck.py /usr/local/bin/agent-sec-daemon-health

LABEL org.opencontainers.image.description="agent-sec-daemon sidecar image" \
      org.opencontainers.image.source="https://github.com/alibaba/anolisa" \
      org.opencontainers.image.title="agent-sec-daemon" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

USER ${AGENT_SEC_UID}:${AGENT_SEC_GID}
WORKDIR /tmp

# The raw wrapper execs its bundled Python runtime, so agent-sec-daemon becomes
# PID 1 and receives Kubernetes SIGTERM/SIGINT directly.
ENTRYPOINT ["/usr/local/bin/agent-sec-daemon"]
CMD ["serve"]
